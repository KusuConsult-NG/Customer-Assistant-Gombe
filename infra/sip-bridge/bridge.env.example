# Copy to bridge.env, fill in, then: sudo ./setup.sh
# Secrets live only in this file on the server (chmod 600). Never commit it.

# ── Alphatech PBX: the extension this server registers as ──
ALPHATECH_HOST=kusuconsult.alphatechpbx.com
ALPHATECH_IP=197.253.11.119
ALPHATECH_EXTENSION=1001
ALPHATECH_PASSWORD=

# ── ElevenLabs: fallback SIP trunk ──
# The same username/password set on the ElevenLabs phone number's INBOUND trunk.
ELEVENLABS_SIP_HOST=sip.rtc.elevenlabs.io
ELEVENLABS_SIP_USERNAME=1001
ELEVENLABS_SIP_PASSWORD=

# The toll-free number exactly as imported in ElevenLabs (E.164).
TOLLFREE_E164=+2348000000779

# ── Bilingual Spitch Voice Mode (Press 1 Hausa / Press 2 Nigerian English) ──
# Set VOICE_MODE=spitch-ivr to enable Press-1 Hausa (hasan) / Press-2 Nigerian English (kingsley),
# or VOICE_MODE=elevenlabs for direct ElevenLabs handoff.
VOICE_MODE=spitch-ivr
SPITCH_API_KEY=
SPITCH_HAUSA_VOICE=hasan
SPITCH_ENGLISH_VOICE=kingsley

# Live Situation Room API tools (search-knowledge, create-ticket, request-callback)
API_BASE_URL=https://gombe-api-3ios.onrender.com
AGENT_TOOL_KEY=

# Optional OpenAI-compatible LLM (OpenAI, Gemini, Groq, OpenRouter) for full multi-turn AI.
# When left blank, the Spitch voice agent runs automatically in Spitch-Direct mode.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional: pre-recorded intro sound (only used in VOICE_MODE=elevenlabs)
INTRO_SOUND=

# Played if the fallback trunk cannot be reached ("all circuits are busy now…").
FALLBACK_SOUND=all-circuits-busy-now

# Leave empty to auto-detect this server's public IP.
PUBLIC_IP=
